# Crypto Volatility Forecaster & Smart Signal Generator Environment Configuration

# Exchange & Assets
ASSETS=BTC/USDT,ETH/USDT,SOL/USDT
SYMBOL=BTC/USDT
EXCHANGE_ID=binance
EXCHANGE_FALLBACKS=bybit,kraken,coinbase
DEFAULT_TIMEFRAME=1h
LOOKBACK_DAYS=730

# Signal Intelligence Thresholds
STRONG_BUY_DIR_THRESHOLD=0.62
STRONG_BUY_CONFIDENCE=0.72
STRONG_BUY_VOL_RATIO_MAX=1.30
STRONG_SELL_DIR_THRESHOLD=0.38
STRONG_SELL_CONFIDENCE=0.72
BUY_DIR_THRESHOLD=0.55
BUY_VOL_RATIO_MAX=1.40
SELL_DIR_THRESHOLD=0.45
VOL_SHOCK_RATIO_THRESHOLD=1.80
MODEL_AGREEMENT_MIN_STRONG=0.75
EVENT_RISK_HOURS_WINDOW=4.0

# Risk Management
INITIAL_CAPITAL=10000.0
MAX_POSITION_RISK_PCT=0.02
STOP_LOSS_ATR_MULTIPLIER=2.0
MAX_DRAWDOWN_LIMIT=0.20
TAKE_PROFIT_RR=2.0
TRANSACTION_COST=0.001
SLIPPAGE=0.0005

# Serving, WebSocket & Caching
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
PAPER_TRADING_ENABLED=true
DRIFT_P_VALUE_THRESHOLD=0.05
WEBSOCKET_ENABLED=true

# Cache TTLs (seconds)
CACHE_TTL_PRICE=3
CACHE_TTL_CANDLES=10
CACHE_TTL_NEWS=180
CACHE_TTL_EVENTS=900
CACHE_TTL_SENTIMENT=300
CACHE_TTL_FUNDAMENTALS=3600

# AI Assistant & Providers
# Options: deterministic | local | huggingface | openai_compatible
LLM_PROVIDER=deterministic
LLM_FALLBACK_PROVIDER=deterministic
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
